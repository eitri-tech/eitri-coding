[
	{
		"name": "Countdown",
		"requiredScopes": [],
		"schema": {
			"title": "Contagem regressiva",
			"description": "Contador até uma data (fim de uma promoção). Some sozinho quando a data passa.",
			"type": "object",
			"required": ["targetDate"],
			"properties": {
				"title": { "type": "string", "title": "Título", "default": "Faltam" },
				"targetDate": { "type": "string", "title": "Data e hora final", "description": "ISO com fuso, ex.: 2026-11-13T10:00:00-03:00", "format": "date-time" },
				"imageUrl": { "type": "string", "title": "Imagem (opcional)", "widget": { "ui:widget": "media-gallery" } },
				"backgroundColor": { "type": "string", "title": "Cor de fundo (opcional)" },
				"startDate": { "type": "string", "title": "Exibir a partir de", "format": "date-time" },
				"endDate": { "type": "string", "title": "Exibir até", "format": "date-time" }
			}
		}
	},
	{
		"name": "VideoStories",
		"requiredScopes": [],
		"schema": {
			"title": "Vídeos (stories)",
			"description": "Vídeos curtos verticais com o produto de cada um.",
			"type": "object",
			"properties": {
				"title": { "type": "string", "title": "Título" },
				"subtitle": { "type": "string", "title": "Subtítulo" },
				"stories": {
					"type": "array",
					"title": "Vídeos",
					"items": {
						"type": "object",
						"title": "Vídeo",
						"required": ["videoUrl"],
						"properties": {
							"videoUrl": { "type": "string", "title": "URL do vídeo (mp4)" },
							"thumbnailUrl": { "type": "string", "title": "Capa", "widget": { "ui:widget": "media-gallery" } },
							"title": { "type": "string", "title": "Nome do produto" },
							"productId": { "type": "string", "title": "Id do produto (abre a PDP)" }
						}
					}
				}
			}
		}
	},
	{
		"name": "TabbedProductShelf",
		"requiredScopes": [],
		"schema": {
			"title": "Vitrine com abas",
			"description": "Uma vitrine com várias abas, cada uma com sua busca (ex.: Mais vendidos, Lançamentos, Melhores descontos).",
			"type": "object",
			"properties": {
				"title": { "type": "string", "title": "Título" },
				"subtitle": { "type": "string", "title": "Subtítulo" },
				"tabs": {
					"type": "array",
					"title": "Abas",
					"items": {
						"type": "object",
						"title": "Aba",
						"required": ["label"],
						"properties": {
							"label": { "type": "string", "title": "Nome da aba" },
							"term": { "type": "string", "title": "Termo de busca (opcional)" },
							"facets": {
								"type": "array",
								"title": "Facets",
								"items": {
									"type": "object",
									"required": ["key", "value"],
									"properties": {
										"key": { "type": "string", "title": "Key", "description": "Para coleção use: productClusterIds", "default": "productClusterIds" },
										"value": { "type": "string", "title": "Value" }
									}
								}
							},
							"sort": {
								"title": "Ordenação",
								"type": "string",
								"default": "score:desc",
								"enum": ["discount:desc", "name:asc", "name:desc", "orders:desc", "price:asc", "price:desc", "release:desc", "score:desc"]
							},
							"numberOfItems": { "type": "integer", "title": "Quantidade", "default": 8 }
						}
					}
				}
			}
		}
	}
]
